{
  "name": "vite-plugin-fable",
  "version": "0.2.1",
  "description": "",
  "keywords": [],
  "homepage": "http://fable.io/vite-plugin-fable/",
  "license": "Apache-2.0",
  "author": "nojaf",
  "funding": "https://nojaf.com/",
  "files": [
    "dist",
    "bin",
    "cracking.fsx"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:daemon": "dotnet publish Fable.Daemon/Fable.Daemon.fsproj --nologo -c Release -p:UseAppHost=false -o ./bin",
    "test": "bun test",
    "lint": "oxlint --deny-warnings && bun run lint:types",
    "lint:types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.docs.json",
    "prepublishOnly": "bun run build:daemon && bun run build && bun ../../scripts/changelog-updater.ts"
  },
  "dependencies": {
    "@babel/code-frame": "^8.0.0",
    "@fable-org/fable-library-js": "catalog:",
    "@rolldown/pluginutils": "^1.0.1",
    "picocolors": "^1.1.1",
    "ts-lsp-client": "1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "keep-a-changelog": "^3.1.0",
    "typescript": "7.0.2",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  }
}
