{
  "name": "vite-plugin-fable-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "sample-project"
    ],
    "catalog": {
      "@fable-org/fable-library-js": "2.5.1",
      "vite": "^8.2.2",
      "vite-plugin-inspect": "^12.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "bun run build",
    "build": "bun run build:daemon && bun run build:plugin",
    "build:daemon": "bun run --cwd packages/vite-plugin-fable build:daemon",
    "build:plugin": "bun run --cwd packages/vite-plugin-fable build",
    "fmt": "oxfmt && dotnet fantomas .",
    "fmt:check": "oxfmt --check && dotnet fantomas check .",
    "lint": "bun run --cwd packages/vite-plugin-fable lint",
    "test": "bun run test:plugin && bun run test:daemon",
    "test:plugin": "bun run --cwd packages/vite-plugin-fable test",
    "test:daemon": "dotnet test",
    "sample": "bun run --cwd sample-project dev"
  },
  "devDependencies": {
    "copy-to-clipboard": "^4.0.2",
    "lit": "^3.3.3",
    "oxfmt": "0.65.0"
  }
}
