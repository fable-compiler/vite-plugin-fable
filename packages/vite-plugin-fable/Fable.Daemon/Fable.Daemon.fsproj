<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- FCS ships as IL, and the tiered JIT otherwise keeps it at tier 0 for most of the first
         type-check. Costs no memory; the server GC half of fable-compiler/Fable#5073 does, so that
         one is the `serverGC` plugin option instead. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="MSBuild.fsi" />
    <Compile Include="MSBuild.fs" />
    <Compile Include="Caching.fsi" />
    <Compile Include="Caching.fs" />
    <Compile Include="ProjectCracking.fsi" />
    <Compile Include="ProjectCracking.fs" />
    <!-- Copied next to the assembly, because the daemon now ships prebuilt: it is no longer
         compiled in the folder it is served from. -->
    <Content Include="debug\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="debug\favicon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="Debug.fsi" />
    <Compile Include="Debug.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.React" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.SystemTextJson" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Suave" />
    <PackageReference Include="protobuf-net" />
  </ItemGroup>
</Project>
