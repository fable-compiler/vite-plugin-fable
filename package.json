{
  "name": "vite-plugin-fable-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "sample-project"
    ],
    "catalog": {
      "@fable-org/fable-library-js": "2.5.1",
      "vite": "^8.2.2",
      "vite-plugin-inspect": "^12.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "bun run build",
    "build": "bun run build:daemon && bun run build:plugin",
    "build:daemon": "bun run --cwd packages/vite-plugin-fable build:daemon",
    "build:plugin": "bun run --cwd packages/vite-plugin-fable build",
    "ci": "bun run --no-exit-on-error --parallel lint fmt test",
    "fmt": "oxfmt && dotnet fantomas .",
    "fmt:check": "oxfmt --check && dotnet fantomas check .",
    "lint": "oxlint --deny-warnings && bun run lint:types",
    "lint:types": "tsc --noEmit -p tsconfig.scripts.json && bun run --cwd packages/vite-plugin-fable lint:types",
    "test": "bun run test:plugin && bun run test:daemon",
    "test:plugin": "bun run --cwd packages/vite-plugin-fable test",
    "test:daemon": "dotnet test",
    "sample": "bun run --cwd sample-project dev",
    "docs": "dotnet fsdocs watch --noapidocs --projects packages/vite-plugin-fable/Fable.Daemon/Fable.Daemon.fsproj",
    "release:detect": "bun scripts/release-detect.ts",
    "release:publish": "bun scripts/release-publish.ts"
  },
  "devDependencies": {
    "@nojaf/oxlint-plugin-annotate-non-primitives": "^0.1.1",
    "@types/bun": "^1.4.0",
    "copy-to-clipboard": "^4.0.2",
    "keep-a-changelog": "^3.1.0",
    "lit": "^3.3.3",
    "oxfmt": "0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "crossws@0.4.12": "patches/crossws@0.4.12.patch"
  }
}
