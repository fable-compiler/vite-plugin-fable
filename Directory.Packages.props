<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Fable.React" Version="9.4.0" />
    <PackageVersion Include="FSharp.Core" Version="10.1.402" />
    <PackageVersion Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
    <PackageVersion Include="Fable.Compiler" Version="5.21.0" />
    <PackageVersion Include="Suave" Version="3.7.2" />
    <PackageVersion Include="protobuf-net" Version="3.4.30" />
    <!-- lock transitive dependencies -->
    <PackageVersion Include="Fable.AST" Version="5.1.0" />
    <PackageVersion Include="System.Collections" Version="4.3.0" />
    <PackageVersion Include="System.Diagnostics.Debug" Version="4.3.0" />
    <PackageVersion Include="System.IO.FileSystem.Primitives" Version="4.3.0" />
    <PackageVersion Include="System.Runtime.Extensions" Version="4.3.1" />
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!-- unit test project -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Nerdbank.Streams" Version="2.14.408" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
</Project>
