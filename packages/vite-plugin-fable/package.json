{
  "name": "vite-plugin-fable",
  "version": "0.2.1",
  "description": "",
  "keywords": [],
  "homepage": "http://fable.io/vite-plugin-fable/",
  "license": "Apache-2.0",
  "author": "nojaf",
  "funding": "https://nojaf.com/",
  "files": [
    "dist",
    "cracking.fsx",
    "Directory.Build.props",
    "Directory.Packages.props",
    "Fable.Daemon/*.fsproj",
    "Fable.Daemon/**/*.fs",
    "Fable.Daemon/**/*.fsi",
    "Fable.Daemon/debug",
    "!Fable.Daemon/obj",
    "!Fable.Daemon/README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:daemon": "dotnet publish Fable.Daemon/Fable.Daemon.fsproj --nologo -c Release --ucr -p:PublishReadyToRun=true -o ./bin",
    "test": "bun test",
    "postinstall": "bun run build:daemon",
    "lint": "oxlint && bun run lint:types",
    "lint:types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.docs.json",
    "prepublishOnly": "cp ../../Directory.Build.props ../../Directory.Packages.props . && bun run build && bun ../../scripts/changelog-updater.ts"
  },
  "dependencies": {
    "@babel/code-frame": "^8.0.0",
    "@fable-org/fable-library-js": "catalog:",
    "picocolors": "^1.1.1",
    "promise.withresolvers": "^1.0.4",
    "rxjs": "^7.8.2",
    "ts-lsp-client": "1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "keep-a-changelog": "^3.1.0",
    "typescript": "7.0.2",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  }
}
